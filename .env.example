# Copy to .env and adjust. `.env` is git-ignored.

# Environment
NODE_ENV=development

# PostgreSQL (required) — consumed by docker-compose and the app
POSTGRES_USER=bunbooru
POSTGRES_PASSWORD=bunbooru
POSTGRES_DB=bunbooru
POSTGRES_PORT=5432
DATABASE_URL=postgres://bunbooru:bunbooru@localhost:5432/bunbooru

# Integration tests (optional) — opt-in URL for the destructive integration
# suite, which TRUNCATEs between cases. Kept separate from DATABASE_URL so the
# tests can never wipe a real database; unset → those tests skip. Point it at a
# THROWAWAY database only. `test-setup.ts` (a Bun test preload) enforces this:
# it refuses to run when this resolves to the same database as DATABASE_URL, or
# when the database name does not end in `_test`.
# TEST_DATABASE_URL=postgres://bunbooru:bunbooru@localhost:5432/bunbooru_test

# Console log rendering: `pretty` (aligned + colourised) or `json` (one object
# per line, for log aggregation). Defaults to pretty in development, json
# otherwise — set it to reproduce production output locally.
# LOG_FORMAT=json

# Max pooled Postgres connections per handle (Bun's default is 10). One
# long-lived server does not need this; the test preload sets it low because a
# handle per test file otherwise exhausts Postgres' connection ceiling.
# DB_POOL_MAX=10

# Redis (optional accelerator) — only when running the `redis` compose profile
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# Uploads & storage (all optional; sensible defaults shown)
# STORAGE_ROOT=./data/storage              # where asset blobs live (required in production)
# MAX_UPLOAD_BYTES=104857600               # one-shot POST /assets cap (<= 2 GiB request body); default 100 MiB
# MAX_RESUMABLE_UPLOAD_BYTES=10737418240   # resumable cap; chunked, so may exceed 2 GiB; default 10 GiB
# UPLOAD_GC_INTERVAL_MS=900000             # sweep expired upload sessions; default 15 min, 0 disables
# ASSET_ORPHAN_GC_INTERVAL_MS=86400000     # sweep orphaned asset blobs (full scan); default 24 h, 0 disables

# Auth (all optional; sensible defaults shown)
# SESSION_EXPIRY_MS=2592000000             # login-session lifetime (cookie Max-Age + DB expiry); default 30 days
# SESSION_GC_INTERVAL_MS=3600000           # sweep expired login sessions; default 1 h, 0 disables
# TRUST_PROXY=false                        # trust X-Forwarded-For for the rate-limit client IP; enable ONLY behind a proxy that sets it

# Mail & password reset
# PUBLIC_BASE_URL=https://booru.example    # absolute WEB origin for links in reset/verify emails; REQUIRED when a mail
#                                          # provider is active (fail-fast in production). NEVER derived from the request
#                                          # Host header. Must address the WEB server, NOT this API's port: in production
#                                          # they are the same origin, but in dev the web server (WEB_PORT, default 3001)
#                                          # proxies /api/* to the API — a link at the API port hits a route that does not
#                                          # exist there and returns a JSON 404. In dev it defaults to
#                                          # http://localhost:<WEB_PORT>.
# REQUIRE_VERIFIED_EMAIL_FOR_RESET=false   # FIRST-BOOT SEED for the reset-verification policy (admin-editable at runtime);
#                                          # when true, only a VERIFIED email may self-serve reset. Default false.

# Runtime settings note: the upload caps (MAX_UPLOAD_BYTES / MAX_RESUMABLE_UPLOAD_BYTES)
# above are DEFAULTS — an admin can override them at runtime via the /admin page.

# Plugins — FIRST-BOOT SEED ONLY (comma-separated plugin ids). All registered
# first-party plugins are loaded + migrated at startup; this list only sets which
# ones start ACTIVE the very first time (when the plugin_states table is empty).
# After that, activate/deactivate them at runtime under Admin → Extensions — this
# value is ignored once any plugin has been toggled. Unknown ids are logged/skipped.
# ENABLED_PLUGINS=example,thumbnailer,shimmie-import

# smtp-mailer plugin — outgoing email is configured entirely in the admin UI
# (Admin → Extensions → Email): host, port, TLS, username, password. There is NO
# SMTP_* connection env. Until a host is saved the plugin runs "log-only" (mail is
# written to the server log instead of sent), so mail-dependent flows are testable
# with zero configuration.
# SMTP_OUTBOX_POLL_MS=15000                # outbox worker drain interval (ops tuning); default 15s
