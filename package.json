{
  "name": "bunbooru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "typecheck": "bun check && bun check -p apps/web",
    "test": "NODE_ENV=test bun test",
    "dev": "bun --watch scripts/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "worker": "bun --watch apps/api/src/index.ts worker",
    "db:generate": "bun run --cwd packages/db db:generate",
    "gen:migrations": "bun run scripts/embed-migrations.ts",
    "db:studio": "bun run --cwd packages/db db:studio",
    "migrate": "bun run --cwd packages/db migrate",
    "seed": "bun run scripts/seed.ts",
    "reset-password": "bun run scripts/reset-password.ts",
    "cr": "bun bin/cr.ts",
    "build": "bun run apps/api/build.ts",
    "build:web": "bun run apps/web/build.ts",
    "docker:build": "docker build -t bunbooru:latest .",
    "services:up": "docker compose up -d",
    "services:up:redis": "docker compose --profile redis up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "lint:boundaries": "depcruise apps packages plugins"
  },
  "dependencies": {
    "@bunbooru/core": "workspace:*",
    "@bunbooru/db": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "bun-plugin-tailwind": "^0.1.2",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
